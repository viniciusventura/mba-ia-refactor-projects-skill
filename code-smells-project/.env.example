# Chave usada para assinar os tokens de login. Sem ela, uma chave aleatória é gerada a cada boot
# (tokens emitidos antes de um restart deixam de valer).
SECRET_KEY=
# Debug do Flask (true/false). Nunca habilite em produção.
FLASK_DEBUG=false
DATABASE_PATH=loja.db
HOST=0.0.0.0
PORT=5000
# Valor exibido em GET /health
APP_ENV=producao
# Validade do token de login, em segundos
TOKEN_MAX_AGE=3600
