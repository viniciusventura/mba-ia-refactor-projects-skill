# Chave para assinar os tokens de login. Obrigatória em produção.
# Se ausente, o app gera uma chave aleatória por processo (os tokens deixam de valer a cada restart).
SECRET_KEY=
# true para ligar o modo debug do Flask (nunca em produção)
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
DB_PATH=loja.db
# validade do token de login, em segundos
TOKEN_MAX_AGE=3600
# valor devolvido em "ambiente" no GET /health
APP_ENV=producao
