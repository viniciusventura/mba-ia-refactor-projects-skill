# Copie para .env (ou exporte no shell) e preencha. Nenhuma variável é obrigatória para subir em desenvolvimento.

# Chave da aplicação. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
# Token exigido em "Authorization: Bearer <token>" pelo POST /admin/reset-db. Vazio = rota sempre bloqueada (401).
ADMIN_TOKEN=
# true habilita o modo debug do Flask (nunca em produção).
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
DATABASE_PATH=loja.db
AMBIENTE=producao
