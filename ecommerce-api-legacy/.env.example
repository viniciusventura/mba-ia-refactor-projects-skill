# Porta HTTP (default 3000)
PORT=3000

# Arquivo SQLite; o default ":memory:" recria o banco e o seed a cada boot
DATABASE_FILE=:memory:

# Chave do gateway de pagamento (nunca versionar o valor real)
PAYMENT_GATEWAY_KEY=

# Token exigido em "Authorization: Bearer <token>" nas rotas administrativas.
# Sem valor, essas rotas respondem sempre 401.
ADMIN_TOKEN=
