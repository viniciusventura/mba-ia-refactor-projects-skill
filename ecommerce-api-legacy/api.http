@baseUrl = http://localhost:3000
# Mesmo valor da variável de ambiente ADMIN_TOKEN usada ao subir a API
@adminToken = troque-pelo-seu-token

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Relatório financeiro administrativo (exige token de admin)
GET {{baseUrl}}/api/admin/financial-report
Authorization: Bearer {{adminToken}}

### Remover usuário (soft delete, exige token de admin)
DELETE {{baseUrl}}/api/users/1
Authorization: Bearer {{adminToken}}
