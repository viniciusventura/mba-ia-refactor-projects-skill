# Copie para .env e ajuste. Nenhum valor real deve ser versionado.
# Sem SECRET_KEY, uma chave aleatória é gerada a cada boot (tokens deixam de valer após restart).
SECRET_KEY=troque-por-um-valor-aleatorio-longo
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
# validade do token de login, em segundos
TOKEN_MAX_AGE=3600
