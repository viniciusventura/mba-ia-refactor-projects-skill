# Copie para .env e ajuste. Todas são opcionais em desenvolvimento.
# Chave que assina os tokens de login. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=troque-por-um-valor-aleatorio-longo
# Banco (relativo à pasta instance/ no Flask-SQLAlchemy 3)
DATABASE_URL=sqlite:///tasks.db
# Validade do token em segundos
TOKEN_MAX_AGE=3600
DEBUG=false
HOST=0.0.0.0
PORT=5000
